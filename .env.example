# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# OpenAI (for PixelForge vendor agent)
OPENAI_API_KEY=sk-your-openai-key

# Anthropic (for lead gen crew agents)
ANTHROPIC_API_KEY=sk-ant-your-claude-api-key

# Optional — Tavily web search for ResearchAgent (free tier: 1000 req/month)
# Get key at https://tavily.com — if not set, falls back to pure Claude
TAVILY_API_KEY=tvly-your-key-here

# Platform URL (agents use this to connect)
PLATFORM_URL=http://localhost:3000

# Admin dashboard password (required in production)
ADMIN_PASSWORD=your-admin-password

# Cron job secret — Vercel sends this automatically as Authorization: Bearer $CRON_SECRET
# Set this in Vercel dashboard + .env.local
CRON_SECRET=your-random-cron-secret

# Demo agent API keys (raw, unhashed — hash with bcrypt before inserting into DB)
BUYER_API_KEY=pk_buyer_procurebot_demo_key_001
VENDOR_API_KEY=pk_vendor_pixelforge_demo_key_001
